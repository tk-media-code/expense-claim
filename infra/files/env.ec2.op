# EC2 に配る環境変数の雛形。値そのものは書かず、1Password の参照（op://）だけを書く。
#
# 値は 1Password の tk-media 保管庫のアイテム expense-claim-aws にある。
# scripts/deploy.sh --env がこのファイルを 1Password で解決し、DATABASE_URL・TAG・APP_URL を
# terraform output と git から足して、EC2 の ~/expense-claim/.env（600）に置く。
# したがって DATABASE_URL・TAG・APP_URL はここに書かない（書いても捨てられる）。
#
# 1Password を使わないときは、このファイルを写して参照を実値に置き換え、
# ENV_FILE=<そのファイルのパス> を付けて deploy.sh を実行する。
# 写したファイルは .env で始まる名前（infra/.env.ec2 など）にすると、コミットされない。
#
# 値の書き方:
#   - 1 行 1 変数。引用符を付けない。参照の行は、値の全体を参照にする
#   - docker compose は引用符の無い値の $ を変数展開として解釈するので、
#     秘密は $ や引用符を含まない 16 進で作る（下の openssl のとおり）
#   - 実値をこのファイルに書かない。リポジトリは public である

# --- 認証（必須） ---

# セッション Cookie の署名鍵。16 文字以上。
# 1Password には  openssl rand -hex 32  で作った値を入れる
SESSION_SECRET=op://tk-media/expense-claim-aws/session-secret

# リフレッシュトークンの暗号鍵。16 文字以上。
# 1Password には  openssl rand -hex 32  で作った値を入れる
# スタブ運用ではトークンを保存しないが、backend の起動時検証が値を要求する
TOKEN_ENCRYPTION_KEY=op://tk-media/expense-claim-aws/token-encryption-key

# 許可するメールアドレス。スタブのログインはこのアドレス本人として通す。
# 実物の Google に繋がないので、実在するアドレスである必要は無い
ALLOWED_EMAIL=someone@example.com

# --- Google（この環境ではスタブ） ---

# 実物の Google を叩かず、開発用のスタブ実装に差し替える（backend/src/integrations/stub）。
# 本番の compose.yaml は渡さない変数だが、この環境は HTTPS もドメインも持たず、
# Google のウェブアプリ型 OAuth（リダイレクト URI に https とドメイン名が必須）が通らないため、
# 意図的にスタブで動かす（docs/decisions.md 決定26）。
GOOGLE_STUB=1

# 以下はスタブでは使わない。空のままでよい。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_LOGIN=
GOOGLE_REDIRECT_URI_AUTHORIZATION=
SPREADSHEET_ID=
MY_SHEET_NAME=
DRIVE_FOLDER_ID=
GMAIL_SENDER=
ALERT_TO=
