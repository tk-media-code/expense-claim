# このファイルを terraform.tfvars にコピーして、実際の値を記入する。
# terraform.tfvars は .gitignore 済みでコミットされない。

# SSH を許可する送信元。自分のグローバル IP に /32 を付ける。
# 確認方法: curl -s https://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.1/32"

# HTTP を許可する送信元。必須で、0.0.0.0/0 は指定できない。
# この環境は GOOGLE_STUB=1 で動かすため、80 番に届く人は誰でもログインできる。
# スマートフォンから見たいときは、その回線のグローバル IP を足す。
http_allowed_cidrs = ["203.0.113.1/32"]

# RDS のマスターパスワード。英数字のみ 16〜41 文字。
# 生成方法: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 24; echo
db_password = "CHANGE_ME_alnum_only_16_to_41"
