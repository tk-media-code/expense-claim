#!/bin/bash
# generated by tk-media harness — DO NOT EDIT
# 変更したい場合はこのファイルを直接編集してよい（以後このファイルは上書きされません）
#
# git の pre-push フック。全リポジトリに配布される。送信の前に次を行う。
#
#   1. 保護ブランチ（main / master）への直接送信を止める。
#      GitHub の Repository Ruleset が使えるリポジトリではサーバー側も拒否するが、
#      使えないリポジトリ（Free プランの private など）では、これが唯一の守りになる。
#   2. 共通チェック（scripts/harness-check.cjs）→ プロジェクトの品質チェック
#      （scripts/quality-check.{cjs,mjs,js,sh}）を走らせ、落ちたら送信を止める。
#      人が端末から git push したときにもチェックを効かせるためのもの。
#      チェックは今の HEAD と作業フォルダを見るので、今のブランチ以外のコミットを送ろうとしたときは、
#      チェックを走らせずに止める（送るブランチに切り替えてから push し直す）。
#
# AI が push するときは、Claude の hook が先に同じチェックを走らせて印を書く。
#   <git の共通ディレクトリ>/tk-harness/push-checked
#   1 行「<コミットの ID> <UNIX 秒> <ブランチの ref>」
# 印が今の状態（同じ ID・同じブランチ・追跡ファイルに変更なし・10 分以内）と合うときは、
# 同じチェックを 2 回走らせないように、ここでは走らせない。印が読めない・形が違うときは、飛ばさずに走らせる。
#
# core.hooksPath はローカル設定でありコミットされない。**再クローンしたら
# node ai-harness/protect.mjs を叩き直す必要がある。**
#
# 緊急時は SKIP_QUALITY_CHECK=1 git push（チェックだけ飛ばす。main への送信は止まる）か、
# git の標準機能 --no-verify（このフック全体を飛ばす）で迂回できる。
# ただしサーバー側の保護が無いリポジトリでは、--no-verify は最後の砦も外すことを理解した上で使うこと。

set -uo pipefail

# 印の有効期間（秒）。guard-core.cjs が印を書いてから push までの間に許す長さ。
MARK_MAX_AGE=600

zero_sha() {
	# 0 だけ（ブランチの削除）か。空も「0 だけ」と同じに扱う。
	case "$1" in
		*[!0]*) return 1 ;;
		*) return 0 ;;
	esac
}

blocked=0
check_ids=()
check_refs=()
check_lines=0

# stdin に「<ローカルref> <ローカルsha> <リモートref> <リモートsha>」が1行ずつ来る。
# ローカル ref の欄には空白が入りうる（HEAD@{0 seconds ago} など）ので、先頭から 4 つに割らず、
# 右から 3 欄（リモート ID・リモート ref・ローカル ID）を取り、残りをローカル ref とする。
# 最後の行に改行が無くても読み落とさない（read は失敗を返すが、変数には入っている）。
while IFS= read -r line || [ -n "$line" ]; do
	[ -n "$line" ] || continue
	# 右から 3 欄を取り、形を確かめる（ローカル ID が 40 桁か 64 桁の 16 進、リモート ref が refs/ で始まる）。
	# 行末の空白や二重の空白があると、欄がずれてこの形に合わなくなる。
	rest="${line% *}"
	_remote_sha="${line##* }"
	remote_ref="${rest##* }"
	rest="${rest% *}"
	local_sha="${rest##* }"
	local_ref="${rest% *}"
	if [ "$rest" = "${line% *}" ] || ! [[ "$local_sha" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] || [[ "$remote_ref" != refs/* ]]; then
		# 想定外の形（4 欄に満たない・欄がずれている）。読み取れた語のどれかが保護ブランチなら止め、
		# そうでなければ、ID を読めない「チェックが要る行」として扱う（印とは必ず合わない ID にする）。
		# 語は read -a で割る（引用符なしの展開だと、行の語がファイル名に展開されうる）。
		remote_ref=""
		read -r -a words <<<"$line"
		for word in "${words[@]:-}"; do
			case "$word" in
				refs/heads/main | refs/heads/master) remote_ref="$word" ;;
			esac
		done
		[ -n "$remote_ref" ] || remote_ref="refs/heads/?"
		local_sha="?"
		local_ref="?"
	fi
	case "$remote_ref" in
		refs/heads/main | refs/heads/master)
			blocked=1
			printf '\n送信をブロックしました: %s へ直接送信しようとしています。\n' "$remote_ref" >&2
			;;
		refs/heads/*)
			# ブランチの送信（削除は除く）だけがチェックの対象。タグなどは対象にしない。
			if ! zero_sha "$local_sha"; then
				check_ids+=("$local_sha")
				check_refs+=("$local_ref → $remote_ref")
				check_lines=$((check_lines + 1))
			fi
			;;
	esac
done

if [ "$blocked" -eq 1 ]; then
	cat >&2 <<'MSG'

このリポジトリは Issue 駆動の開発フローを採っており、既定ブランチへの直接の
変更は禁止されています。変更は必ず Pull Request 経由で入れてください。

正しい手順:
  1. gh issue create でIssueを立てる
  2. git switch -c feature/<issue番号>-<内容>
  3. 作業してコミットし、そのブランチを送信する
  4. gh pr create で PR を作り、内容を確認してからマージする

GitHub 側のブランチ保護が使えないリポジトリ（Free プランの private など）では、このフックが唯一の守りです。
MSG
	exit 1
fi

# チェックが要る行が 1 つも無い（削除だけ・タグだけ・空）
[ "$check_lines" -gt 0 ] || exit 0

if [ "${SKIP_QUALITY_CHECK:-}" = "1" ]; then
	echo "SKIP_QUALITY_CHECK=1 の指定により、品質チェックを飛ばしました。" >&2
	exit 0
fi

# git が hook を呼ぶときの作業ディレクトリは作業ツリーのルートだが、念のため移る。
root="$(git rev-parse --show-toplevel 2>/dev/null)" && cd "$root"

# 今のブランチ（HEAD）以外のコミットを送ろうとしていれば、チェックを走らせずに止める。
# チェック（共通チェックも品質チェックも）は、今の HEAD と作業フォルダの中身を見る。送るコミットが HEAD と違うと、
# そのコミット（途中のコミットも含む）は確かめられないまま送られてしまう。
# ID を読めなかった行（local_sha が ?）は、比べずにチェックへ進む（チェックが要る側に倒す）。
# detached HEAD で今のコミットを送るときは、ID が HEAD と同じなので、そのままチェックへ進む。
head_id="$(git rev-parse HEAD 2>/dev/null)" || head_id=""
differing=()
i=0
for id in "${check_ids[@]}"; do
	if [ "$id" != "?" ] && [ "$id" != "$head_id" ]; then
		differing+=("${check_refs[$i]}")
	fi
	i=$((i + 1))
done
if [ "${#differing[@]}" -gt 0 ]; then
	# 原因の行（ローカル ref → リモート ref）を並べる。ID は出さない（ref 名だけで足りる）。
	printf '\n送信をブロックしました: 今のブランチ以外のコミットを送ろうとしています。\n\n送るコミットが、今の HEAD と違います。\n' >&2
	for row in "${differing[@]}"; do
		printf '  %s\n' "$row" >&2
	done
	cat >&2 <<'MSG'

チェックは、今のブランチ（HEAD）と作業フォルダの中身を見ます。送るコミットが HEAD と違うと、
そのコミットは確かめられないまま送られます。

対応: 送るブランチに切り替えてから（git switch <ブランチ>）、もう一度 push してください。
worktree を使っているなら、そのブランチの worktree の中で push してください。
--all などで複数のブランチを送るときは、1 本ずつ、そのブランチに切り替えて送ってください。
急ぐときは SKIP_QUALITY_CHECK=1 git push か git push --no-verify で飛ばせます（AI は、ユーザーの明示的な指示なしに使ってはいけません）。
MSG
	exit 1
fi

# 印が今の状態と合うか。1 つでも欠ければ偽（飛ばさない）。読めない・形が違うのは、エラーにせず偽にする。
mark_is_valid() {
	local common mark m_id m_ts m_ref m_extra head ref now age id st
	common="$(git rev-parse --git-common-dir 2>/dev/null)" || return 1
	mark="$common/tk-harness/push-checked"
	[ -f "$mark" ] || return 1
	m_id="" m_ts="" m_ref="" m_extra=""
	# 1 行目だけ読む。末尾の改行が無くても変数には入る（read の終了コードは見ない）。
	read -r m_id m_ts m_ref m_extra <"$mark" 2>/dev/null || true

	# 3 欄で、ID が 40 桁の 16 進、秒が数字（長すぎると算術が溢れるので 12 桁まで）。
	[ -n "$m_id" ] && [ -n "$m_ts" ] && [ -n "$m_ref" ] && [ -z "$m_extra" ] || return 1
	[[ "$m_id" =~ ^[0-9a-f]{40}$ ]] || return 1
	[[ "$m_ts" =~ ^[0-9]{1,12}$ ]] || return 1

	head="$(git rev-parse HEAD 2>/dev/null)" || return 1
	[ "$m_id" = "$head" ] || return 1
	ref="$(git symbolic-ref HEAD 2>/dev/null)" || return 1
	[ -n "$ref" ] && [ "$m_ref" = "$ref" ] || return 1

	# 送る行のローカル ID が、どれも印の ID と同じ（HEAD 以外のブランチを送るときは印を使わない）。
	for id in "${check_ids[@]}"; do
		[ "$id" = "$m_id" ] || return 1
	done

	# 新しさ。未来の値は使わない。
	now="$(date +%s)" || return 1
	[[ "$now" =~ ^[0-9]+$ ]] || return 1
	age=$((now - 10#$m_ts))
	[ "$age" -ge 0 ] && [ "$age" -le "$MARK_MAX_AGE" ] || return 1

	# 追跡ファイルに変更が無い。未追跡ファイルは印の約束の外。git が答えないときは偽。
	st="$(git status --porcelain --untracked-files=no 2>/dev/null)" || return 1
	[ -z "$st" ] || return 1
	return 0
}

if mark_is_valid; then
	exit 0
fi

# git が hook に渡した GIT_DIR・GIT_WORK_TREE・GIT_INDEX_FILE・GIT_PREFIX などを、チェックへ持ち込ませない。
# linked worktree から push すると渡され、残したままだと、チェックの中で別の場所の git を叩くテストが
# 利用者のリポジトリを書き換える（githooks(5) の勧めどおり、ここで片付ける）。
# 片付けるのは印の判定のあと、チェックの直前。このフック自身が叩く git（印・HEAD・ブランチ・status）は、
# git が渡した環境のまま読む。そうすると、作業ツリーに .git が無い配置（--git-dir / --work-tree の指定）でも、
# 正しいリポジトリの印を読める。逆に、チェックは片付いた環境で走るので、.git が作業ツリーに無い配置では、
# チェックの中の git が外側のリポジトリを見ることがある。
unset $(git rev-parse --local-env-vars)

# .sh を走らせる bash。AI の hook（guard-core.cjs の resolveBash）と同じ分け方にして、AI の push と人の push で
# 走る bash が変わらないようにする。Windows（Git Bash など）では、PATH の bash が WSL のランチャーのことが
# あるので、このフックを動かしている bash を使う。それ以外は PATH の bash。
case "$(uname -s 2>/dev/null)" in
	MINGW* | MSYS* | CYGWIN*) sh_bash="${BASH:-bash}" ;;
	*) sh_bash=bash ;;
esac

# チェックを 1 本走らせる。引数: 表示名 候補...（最初に見つかった 1 本だけ）。
# 落ちたら案内を出して終了コード 1 で終える。node が要るのに無いときは、飛ばして通す。
run_check() {
	local label="$1" file rc
	shift
	for file in "$@"; do
		[ -f "$file" ] || continue
		case "$file" in
			*.sh) "$sh_bash" "$file" </dev/null >&2 ;;
			*)
				if ! command -v node >/dev/null 2>&1; then
					echo "node が見つからないため、$file を飛ばしました。" >&2
					return 0
				fi
				node "$file" </dev/null >&2
				;;
		esac
		rc=$?
		[ "$rc" -eq 0 ] && return 0
		printf '\n送信をブロックしました: %s（%s）が落ちました。\n' "$label" "$file" >&2
		if [ "$rc" -eq 3 ]; then
			echo "これは品質上の指摘ではなく、環境の問題です。" >&2
		fi
		cat >&2 <<'MSG'

指摘を直してから、もう一度 push してください。急ぐときは SKIP_QUALITY_CHECK=1 git push か git push --no-verify で飛ばせます（AI は、ユーザーの明示的な指示なしに使ってはいけません）。
秘密の指摘で止まったときは、飛ばすと秘密ごと送られます。飛ばさずに直してください。
MSG
		exit 1
	done
	return 0
}

# 順序が意味を持つ（安いほうを先に置き、落ちたら次は走らせない）。
# 候補は share/hooks/lib/guard-core.cjs の CHECKS と同じ。片方だけ直すと、AI の push と人の push で走るものが変わる。
run_check "共通チェック" scripts/harness-check.cjs
run_check "プロジェクト品質チェック" scripts/quality-check.cjs scripts/quality-check.mjs scripts/quality-check.js scripts/quality-check.sh

exit 0
