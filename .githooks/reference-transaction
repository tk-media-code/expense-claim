#!/bin/bash
# generated by tk-media harness — DO NOT EDIT
# 変更したい場合はこのファイルを直接編集してよい（以後このファイルは上書きされません）
#
# プランの寿命をブランチに追随させる git フック。
#
# git には「ブランチ削除フック」が無い。reference-transaction は全ての ref 更新で
# 発火するので、作業ブランチの作成と削除をここで拾う。
#
#   作業ブランチが作られた → 未紐付けのプランをそのブランチに紐付ける
#   作業ブランチが消えた   → 紐付いたブランチが無いプランを消す
#
# AI がスキル経由で動いたときだけでなく、人が端末で git branch -d したときにも効く。
# これがスキル層と分けてフックを置いている理由。
#
# core.hooksPath はローカル設定でありコミットされない。**再クローンしたら
# .harness/protect.sh を叩き直す必要がある。**

set -uo pipefail

# 状態は preparing / prepared / committed / aborted の4つ。
# ref が実際に書き換わった後の committed だけを見る。
#
# preparing と prepared で非ゼロを返すと ref トランザクションが中断される
# （git の仕様上、他の状態では終了コードは無視される）。ここで即座に抜けることで、
# 中断させうる経路そのものを通らない。
[ "${1:-}" = "committed" ] || exit 0

# 空でなく、全ての文字が 0 か。SHA-1 と SHA-256 で長さが違うので桁数では判定しない。
is_zero() {
	case "$1" in
	'' | *[!0]*) return 1 ;;
	*) return 0 ;;
	esac
}

link_branch=''
run_gc=0

# stdin に「<古い値> <新しい値> <ref名>」が1行ずつ来る。
while read -r old new ref; do
	# ローカルブランチ以外は無視する。fetch が動かす refs/remotes/… はここで落ちる。
	case "$ref" in
	refs/heads/*) ;;
	*) continue ;;
	esac

	branch="${ref#refs/heads/}"

	# 作業ブランチの命名規約に合うものだけを見る。main の更新はここで落ちる。
	case "$branch" in
	feature/[0-9]*-* | fix/[0-9]*-*) ;;
	*) continue ;;
	esac

	# 判定は new から先に見る。削除のとき old と new が**両方ゼロ**で来るため
	# （git は「現在値を問わない更新」を old=ゼロで表し、削除もこれに乗る）、
	# old を先に見ると削除を作成と誤判定する。
	#
	#   作成: old=ゼロ  new=<sha>
	#   削除: old=ゼロ  new=ゼロ
	#   更新: old=<sha> new=<sha>
	if is_zero "$new"; then
		run_gc=1
	elif is_zero "$old"; then
		link_branch="$branch"
	fi
done

# 何も該当しなければ、ここまでで終わる。
# 通常のコミットや fetch では bash の起動ぶんしか掛からない。
[ -n "$link_branch" ] || [ "$run_gc" -eq 1 ] || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
store="$root/scripts/plan-store.cjs"
[ -f "$store" ] || exit 0

# plan-store 側も fail-open だが、ここでも結果を握りつぶす。
# プランの整理に失敗しても git の操作は成功させる。
if [ -n "$link_branch" ]; then
	node "$store" link "$link_branch" >/dev/null 2>&1 || true
fi
if [ "$run_gc" -eq 1 ]; then
	node "$store" gc >/dev/null 2>&1 || true
fi

exit 0
