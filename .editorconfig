root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true

# YAML はタブを字下げに使えない（compose が受け付けない）
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Terraform は terraform fmt がスペース2字下げに揃える
[*.{tf,tfvars,tfvars.example,hcl}]
indent_style = space
indent_size = 2
