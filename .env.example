# 環境依存値の雛形。実値は .env に書く（.env はコミットしない）。
#
# このリポジトリは public であり、提出シートには委託元と他スタッフの情報が含まれる。
# スプレッドシートID・シート名・フォルダIDの実値をコミットしてはならない（要求分析 N-08）。
#
# コピー: cp .env.example .env
# 開発の compose は SESSION_SECRET / ALLOWED_EMAIL / TOKEN_ENCRYPTION_KEY / GOOGLE_STUB に
# 既定値を持つので、空のまま起動できる。本番の compose.yaml は前3つが空だと起動時に落ちる。

# --- アプリ本体（backend/src/config/env.ts / 05-integration.md 9章） ---

# データベース。開発の compose は mysql コンテナ向けの既定値を使う
DATABASE_URL=

# セッション Cookie の署名鍵。16文字以上
SESSION_SECRET=

# 許可するメールアドレス（本人）
ALLOWED_EMAIL=

# リフレッシュトークンの暗号鍵。16文字以上
TOKEN_ENCRYPTION_KEY=

# 「ウェブ アプリケーション」型の OAuth クライアント（01-architecture.md 7.1）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_LOGIN=
GOOGLE_REDIRECT_URI_AUTHORIZATION=

# Google を叩かない開発用の実装に差し替える。1 か true のときだけ真。
# 本番の compose.yaml は渡さない。開発の compose.override.yaml の既定は 1。
GOOGLE_STUB=

# 提出先スプレッドシートのID。シートのURL /spreadsheets/d/<ここ>/edit
# 開発で実物に繋ぐときはサンドボックス（下の SANDBOX_SPREADSHEET_ID と同じ値）を入れる。
# 本番のシートを入れれば本番に書ける。提出の確認画面に出る「書き込み先」で、実行前に確かめる
SPREADSHEET_ID=

# 自分のシート名。「<社員番号> <氏名>」の形式
MY_SHEET_NAME=

# 領収書の保管先フォルダ
DRIVE_FOLDER_ID=

# 依頼メールの差出人アドレス。ラベルに頼らない判定の一次条件に使う（N-15 / F-04）
GMAIL_SENDER=

# 提出アラートの宛先（本人固定。NF-13）
ALERT_TO=

# 提出アラートに載せるアプリの URL。空なら載せない
APP_URL=

# --- ローカル MySQL（compose.override.yaml。本番は RDS） ---

MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# ホストで 3306 が埋まっているときだけ
MYSQL_HOST_PORT=

# --- 検証ツール（tools/*-probe。アプリは読まない） ---

# sheet-probe が作った複製を控える
SANDBOX_SPREADSHEET_ID=

# デスクトップ型 OAuth クライアントJSONとトークンの置き場。既定のままで良い
OAUTH_CLIENT_FILE=credentials/oauth-client.json
OAUTH_TOKEN_FILE=credentials/token.json

# gmail-probe が使う。アプリはラベルを条件にしない（05-integration.md 9章 / F-04）
GMAIL_LABEL_NAME=

# drive-probe 用。Drive 上に手で作った検証用フォルダのID。実の領収書フォルダは使わない
DRIVE_PROBE_FOLDER_ID=