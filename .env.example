# 環境依存値の雛形。実値は .env に書く（.env はコミットしない）。
#
# このリポジトリは public であり、提出シートには委託元と他スタッフの情報が含まれる。
# スプレッドシートID・シート名・フォルダIDの実値をコミットしてはならない（要求分析 N-08）。

# 提出先スプレッドシートのID。シートのURL /spreadsheets/d/<ここ>/edit
SPREADSHEET_ID=

# 自分のシート名。「<社員番号> <氏名>」の形式
MY_SHEET_NAME=

# 検証用サンドボックスのID。tools/sheet-probe/probe.cjs sandbox が作った複製を控える
SANDBOX_SPREADSHEET_ID=

# OAuth クライアントJSONとトークンの置き場。既定のままで良い
OAUTH_CLIENT_FILE=credentials/oauth-client.json
OAUTH_TOKEN_FILE=credentials/token.json
